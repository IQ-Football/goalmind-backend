# GoalMind Backend Environment Configuration

# Server
PORT=8080
NODE_ENV=development

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=goalmind
DB_USER=postgres
DB_PASSWORD=postgres

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secrets (change these in production!)
JWT_SECRET=goalmind-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=goalmind-refresh-secret-key
